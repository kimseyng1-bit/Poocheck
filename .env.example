# Anthropic Claude API key
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Daily analysis limits (optional, defaults shown)
# RATE_LIMIT_PER_DEVICE_DAILY=10
# RATE_LIMIT_PER_IP_DAILY=30
# RATE_LIMIT_GLOBAL_DAILY=1000

# Upstash Redis for limits + usage stats. Set automatically when you add
# Upstash Redis from the Vercel Marketplace. Without it, counters are kept in
# memory per server instance (local dev only — not a real limit).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Token for GET /api/stats?token=... (endpoint is hidden when unset)
# STATS_TOKEN=

# SEO (optional)
# NEXT_PUBLIC_SITE_URL=https://poocheck.vercel.app
# GOOGLE_SITE_VERIFICATION=   # Google Search Console "HTML tag" content value
# NAVER_SITE_VERIFICATION=    # Naver Search Advisor "HTML tag" content value
